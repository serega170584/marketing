      "name": "Promotions",
      "item": [
        {
          "name": "Create promotion",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Summer Sale\",\n  \"discount_type\": \"PERCENTAGE\",\n  \"discount_value\": 20,\n  \"max_discount\": 100,\n  \"max_uses\": 1000,\n  \"starts_at\": \"2026-11-15T00:00:00Z\",\n  \"expires_at\": \"2026-12-31T23:59:59Z\",\n  \"status\": \"ACTIVE\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/promotions",
            "description": "Создать новую акцию"
          },
          "response": []
        },
        {
          "name": "Get promotions",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/promotions",
            "description": "Получить список акций"
          },
          "response": []
        },
        {
          "name": "Get promotion by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/promotions/:id",
              "host": ["{{baseUrl}}"],
              "path": ["promotions", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "{{promotionId}}"
                }
              ]
            },
            "description": "Получить акцию по UUID"
          },
          "response": []
        },
        {
