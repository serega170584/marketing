            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Summer Sale Updated\",\n  \"discount_type\": \"PERCENTAGE\",\n  \"discount_value\": 25,\n  \"max_discount\": 150,\n  \"max_uses\": 2000,\n  \"starts_at\": \"2026-11-15T00:00:00Z\",\n  \"expires_at\": \"2026-12-31T23:59:59Z\",\n  \"status\": \"ACTIVE\"\n}",
              "options": {
                "raw": {
